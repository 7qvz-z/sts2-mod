<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>EnemyScaler</AssemblyName>
    <RootNamespace>EnemyScaler</RootNamespace>
    <Version>0.1.0</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</GameDir>
    <GameDataDir>$(GameDir)\data_sts2_windows_x86_64</GameDataDir>
    <!-- Set to false to build without copying into the game's mods folder. -->
    <InstallToGame Condition="'$(InstallToGame)' == ''">true</InstallToGame>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2" HintPath="$(GameDataDir)\sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDataDir)\0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(GameDataDir)\GodotSharp.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="EnemyScaler.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="InstallMod" AfterTargets="Build" Condition="'$(InstallToGame)' == 'true'">
    <PropertyGroup>
      <ModInstallDir>$(GameDir)\mods\$(AssemblyName)</ModInstallDir>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll;$(TargetDir)$(AssemblyName).json" DestinationFolder="$(ModInstallDir)" />
    <Message Importance="high" Text="Installed to $(ModInstallDir)" />
  </Target>

</Project>
